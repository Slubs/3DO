#include "libopera/opera_dsp.h"

#include "opera_lr_callbacks.h"

#include <stdint.h>
#include <string.h>

/* MACROS */
/* Increased buffer size for better audio stability */
/* 4096 samples at 44.1kHz = ~93ms of audio */
/* Ring buffer with power-of-2 size for efficient masking */
#define DSP_BUF_SIZE      4096
#define DSP_BUF_SIZE_MASK (DSP_BUF_SIZE - 1)
#define DSP_BUF_THRESHOLD 512  /* Minimum samples before sending to frontend */

/* Ring buffer structure */
static struct
{
  int32_t  buffer[DSP_BUF_SIZE];
  uint32_t write_idx;  /* Where DSP writes */
  uint32_t read_idx;   /* Where upload reads */
  uint32_t fill_count; /* Number of samples available */
} g_DSP_RING;

/* Temporary buffer for frame-aligned audio upload */
static int16_t g_FRAME_AUDIO[1024];
static uint32_t g_FRAME_AUDIO_IDX = 0;

/* PUBLIC FUNCTIONS */

void
opera_lr_dsp_process(void)
{
  int32_t sample = opera_dsp_loop();
  
  /* Write to ring buffer */
  g_DSP_RING.buffer[g_DSP_RING.write_idx] = sample;
  g_DSP_RING.write_idx = (g_DSP_RING.write_idx + 1) & DSP_BUF_SIZE_MASK;
  
  /* Update fill count with saturation */
  if (g_DSP_RING.fill_count < DSP_BUF_SIZE)
    g_DSP_RING.fill_count++;
}

void
opera_lr_dsp_upload(void)
{
  uint32_t samples_to_read;
  uint32_t i;
  
  /* Calculate how many samples we can read */
  samples_to_read = g_DSP_RING.fill_count;
  
  /* Limit to prevent reading too much at once (frame-aligned) */
  if (samples_to_read > DSP_BUF_THRESHOLD)
  {
    /* Read samples in chunks for smoother audio */
    uint32_t chunk_size = samples_to_read;
    if (chunk_size > sizeof(g_FRAME_AUDIO) / sizeof(g_FRAME_AUDIO[0]))
      chunk_size = sizeof(g_FRAME_AUDIO) / sizeof(g_FRAME_AUDIO[0]);
    
    for (i = 0; i < chunk_size && g_DSP_RING.fill_count > 0; i++)
    {
      int32_t sample = g_DSP_RING.buffer[g_DSP_RING.read_idx];
      g_DSP_RING.read_idx = (g_DSP_RING.read_idx + 1) & DSP_BUF_SIZE_MASK;
      g_DSP_RING.fill_count--;
      
      /* Clamp sample to 16-bit range */
      if (sample > 32767)
        sample = 32767;
      else if (sample < -32768)
        sample = -32768;
      
      g_FRAME_AUDIO[g_FRAME_AUDIO_IDX++] = (int16_t)sample;
    }
  }
  
  /* Send accumulated audio to frontend if we have enough samples */
  if (g_FRAME_AUDIO_IDX >= 256)  /* Send in ~6ms chunks */
  {
    retro_audio_sample_batch_cb(g_FRAME_AUDIO, g_FRAME_AUDIO_IDX);
    g_FRAME_AUDIO_IDX = 0;
  }
}

void
opera_lr_dsp_destroy(void)
{
  /* Flush remaining audio */
  if (g_FRAME_AUDIO_IDX > 0)
  {
    retro_audio_sample_batch_cb(g_FRAME_AUDIO, g_FRAME_AUDIO_IDX);
    g_FRAME_AUDIO_IDX = 0;
  }
}

void
opera_lr_dsp_init(const int threaded_)
{
  /* Initialize ring buffer */
  memset(&g_DSP_RING, 0, sizeof(g_DSP_RING));
  memset(g_FRAME_AUDIO, 0, sizeof(g_FRAME_AUDIO));
  g_FRAME_AUDIO_IDX = 0;
  
  (void)threaded_;  /* Unused in non-threaded mode */
}